<Window x:Class="RewNoiseBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REW Noise Bridge" Width="760" Height="610"
        MinWidth="680" MinHeight="540" Background="#09090B"
        Foreground="#F4F4F5" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="REW NOISE BRIDGE" FontSize="24" FontWeight="Bold" Foreground="#38BDF8"/>
            <TextBlock Margin="0,5,0,0" Foreground="#A1A1AA" TextWrapping="Wrap"
                       Text="Đọc SPL/Leq đã hiệu chuẩn từ REW trên cùng máy (127.0.0.1:4735). Internet không bắt buộc."/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,14" Padding="12" Background="#18181B"
                BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtApiStatus" Text="REW API: đang kiểm tra..." FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtAudioStatus" Margin="0,5,0,0" Foreground="#A1A1AA" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtCalibration" Margin="0,3,0,0" Foreground="#A1A1AA" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnReconnect" Content="KẾT NỐI LẠI" Margin="12,0,0,0"
                        Padding="14,7" Click="BtnReconnect_Click" Background="#0369A1" Foreground="White" BorderThickness="0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="0.75*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="18" Background="#111827" BorderBrush="#1D4ED8"
                    BorderThickness="1" CornerRadius="10" Margin="0,0,8,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SPL hiện tại" HorizontalAlignment="Center" Foreground="#93C5FD" FontSize="14"/>
                    <TextBlock x:Name="TxtSpl" Text="--.-" HorizontalAlignment="Center" FontSize="76"
                               FontWeight="Bold" Foreground="#F8FAFC" FontFamily="Consolas"/>
                    <TextBlock x:Name="TxtSplUnit" Text="dB SPL" HorizontalAlignment="Center" FontSize="18" Foreground="#93C5FD"/>
                    <Separator Margin="0,16,0,12" Background="#334155"/>
                    <UniformGrid Columns="2">
                        <StackPanel>
                            <TextBlock Text="Leq" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtLeq" Text="--.- dB" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="LZ Peak" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtPeak" Text="--.- dB" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="15" Background="#18181B" BorderBrush="#3F3F46"
                    BorderThickness="1" CornerRadius="10" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="CẤU HÌNH REW" FontWeight="Bold" Foreground="#D4D4D8"/>
                    <TextBlock Text="Weighting" Margin="0,12,0,4" Foreground="#A1A1AA"/>
                    <ComboBox x:Name="ComboWeighting" SelectedIndex="2" Padding="8,5">
                        <ComboBoxItem Content="A"/>
                        <ComboBoxItem Content="C"/>
                        <ComboBoxItem Content="Z"/>
                    </ComboBox>
                    <TextBlock Text="Time weighting" Margin="0,10,0,4" Foreground="#A1A1AA"/>
                    <ComboBox x:Name="ComboFilter" SelectedIndex="1" Padding="8,5">
                        <ComboBoxItem Content="Fast"/>
                        <ComboBoxItem Content="Slow"/>
                    </ComboBox>
                    <Button x:Name="BtnStart" Content="MỞ + BẮT ĐẦU" Margin="0,16,0,0" Padding="10,8"
                            Click="BtnStart_Click" Background="#047857" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="BtnStop" Content="DỪNG" Margin="0,8,0,0" Padding="10,8"
                            Click="BtnStop_Click" Background="#991B1B" Foreground="White" BorderThickness="0"/>
                    <Button x:Name="BtnReset" Content="RESET THỐNG KÊ" Margin="0,8,0,0" Padding="10,8"
                            Click="BtnReset_Click" Background="#3F3F46" Foreground="White" BorderThickness="0"/>
                    <Separator Margin="0,16,0,12" Background="#3F3F46"/>
                    <TextBlock Text="Ổn định 10 giây" Foreground="#A1A1AA"/>
                    <TextBlock x:Name="TxtRange" Text="Range: -- dB" Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtStdDev" Text="σ: -- dB" Margin="0,3,0,0"/>
                    <TextBlock x:Name="TxtElapsed" Text="REW elapsed: -- s" Margin="0,3,0,0" Foreground="#A1A1AA"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,14,0,0" Padding="12" Background="#27272A" CornerRadius="8">
            <TextBlock x:Name="TxtDiagnosis" TextWrapping="Wrap" Foreground="#FDE68A"
                       Text="Chưa có dữ liệu. Hãy mở REW 5.40+, bật API và hiệu chuẩn SPL trước khi đo."/>
        </Border>
    </Grid>
</Window>
