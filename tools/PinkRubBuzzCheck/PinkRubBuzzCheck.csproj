<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AudioAppDir>$([System.IO.Path]::GetDirectoryName($(AudioAssemblyPath)))</AudioAppDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SoncaAudioInspector" HintPath="$(AudioAssemblyPath)" />
    <!-- Same binaries as the app under test; resolved from the app directory at runtime. -->
    <Reference Include="MathNet.Numerics" HintPath="$(AudioAppDir)\MathNet.Numerics.dll" Private="false" />
    <Reference Include="NAudio.Core" HintPath="$(AudioAppDir)\NAudio.Core.dll" Private="false" />
  </ItemGroup>
</Project>
