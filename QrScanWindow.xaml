<UserControl x:Class="SoncaAudioInspector.QrScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#0E0E10" Foreground="#E4E4E7" Loaded="Window_Loaded"
        PreviewKeyDown="QrScanWindow_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="QrButtonBase" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#71717A"/>
                    <Setter Property="Background" Value="#1F1F22"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QrScanButtonStyle" TargetType="Button" BasedOn="{StaticResource QrButtonBase}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#60A5FA"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="QrActionButtonStyle" TargetType="Button" BasedOn="{StaticResource QrButtonBase}">
            <Setter Property="Background" Value="#27272A"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3F3F46"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="QrSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource QrButtonBase}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#06130F"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#34D399"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ScanTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="4"/>
                            <Border x:Name="focusBorder" BorderBrush="White" BorderThickness="1.5" CornerRadius="4" Opacity="0"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focusBorder" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="BlinkStoryboard">
                                        <Storyboard>
                                            <DoubleAnimation 
                                                Storyboard.TargetName="focusBorder" 
                                                Storyboard.TargetProperty="Opacity"
                                                From="0" To="1" Duration="0:0:0.2" 
                                                AutoReverse="True" RepeatBehavior="3x"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Overlay Dialog for Update Item -->
        <Border Name="UpdateItemOverlay" Grid.RowSpan="2" Background="#90000000" Panel.ZIndex="100" Visibility="Collapsed">
            <Border Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="CẬP NHẬT BARCODE ITEM" Foreground="#C4B5FD" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="Mã cũ:" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Name="TxtOldItemCode" Height="38" Background="#27272A" Foreground="#71717A" BorderThickness="0" Padding="10,5" VerticalContentAlignment="Center" IsReadOnly="True" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Mã mới:" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Name="TxtNewItemCode" Height="38" Background="#18181B" Foreground="White" BorderBrush="#3B82F6" BorderThickness="1" Padding="10,5" VerticalContentAlignment="Center" Margin="0,0,0,20"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource QrActionButtonStyle}" Click="BtnCancelUpdateItem_Click"/>
                        <Button Name="BtnConfirmUpdateItem" Grid.Column="2" Content="Confirm" Style="{StaticResource QrScanButtonStyle}" Click="BtnConfirmUpdateItem_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Moved above UpdateItemOverlay to fix MC3088 -->
        <Border Name="UpdateItemOverlayPlaceholder" Visibility="Collapsed" />

        <Border Name="TransientErrorToast" Grid.RowSpan="2" Panel.ZIndex="200" Visibility="Collapsed"
                IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0"
                Background="#B91C1C" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="7" Padding="16,10">
            <TextBlock Name="TxtTransientError" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"/>
        </Border>

        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="16,11">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="QUÉT SẢN PHẨM VÀ ITEM" FontSize="13" FontWeight="Bold" Foreground="#F4F4F5"/>
                    <TextBlock Name="ScanSubtitle" Text="Chọn Model một lần, sau đó quét liên tục bằng scanner USB." Margin="0,4,0,0" FontSize="11" Foreground="#A1A1AA"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Name="SyncSpinner" Width="54" Height="5" Margin="0,0,9,0"
                                 VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed"
                                 Foreground="#60A5FA" Background="#27272A" BorderThickness="0"/>
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,7,0"/>
                    <TextBlock Name="TxtScanStatus" Text="Sẵn sàng" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Active Scan Area -->
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <Grid>
                                <TextBlock Name="TxtScanCounter" Text="SCAN" Foreground="#34D399" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Name="BtnImportBom" Content="Nhập BOM + Items" Width="142" Margin="0,0,8,0" ToolTip="Chọn 2 file Excel để đồng bộ BOM theo model và danh mục Items" Style="{StaticResource QrActionButtonStyle}" Click="BtnImportBom_Click"/>
                                    <Button Name="BtnEditLayout" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="42" MinWidth="42" Margin="0,0,8,0" ToolTip="Chỉnh bố trí item" Style="{StaticResource QrActionButtonStyle}" Click="BtnEditLayout_Click"/>
                                    <Button Name="BtnLayoutFullscreen" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="42" MinWidth="42" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="Phóng to vùng chỉnh layout" Style="{StaticResource QrActionButtonStyle}" Click="BtnLayoutFullscreen_Click"/>
                                    <Button Name="BtnAddItem" Content="+" Width="42" MinWidth="42" Margin="0,0,8,0" FontSize="20" Visibility="Collapsed" ToolTip="Thêm item cho model đang chọn" Style="{StaticResource QrActionButtonStyle}" Click="BtnAddItem_Click"/>
                                    <Button Name="BtnSaveLayout" Content="Lưu cấu hình" Width="112" Margin="0,0,10,0" Visibility="Collapsed" Style="{StaticResource QrScanButtonStyle}" Click="BtnSaveLayout_Click"/>
                                    <Button Name="BtnCreateBarcode" Content="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="42" MinWidth="42" Margin="0,0,10,0" ToolTip="Xuất ảnh barcode A4 ngang" Style="{StaticResource QrActionButtonStyle}" Click="BtnCreateBarcode_Click"/>
                                    <Button Name="BtnConfirm" Content="Gửi" Width="72" Margin="0,0,10,0" Style="{StaticResource QrSuccessButtonStyle}" Click="BtnConfirm_Click"/>
                                    <Button Content="Hủy" Width="70" Margin="0,0,0,0" Style="{StaticResource QrActionButtonStyle}" Click="BtnCancel_Click"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Name="ActiveScanPanel" Margin="0,10,0,0">
                                <TextBlock Name="TxtLayoutHint" Text="Kéo gần cạnh/tâm để tự gióng thẳng, không chồng hình · Ctrl+S để lưu · Ctrl+R để xoay · Ctrl +/- để đổi kích thước · ⛶ để phóng to" Foreground="#60A5FA" FontSize="11" Margin="0,0,0,8" Visibility="Collapsed"/>
                                <Border Background="#18181B" BorderBrush="#71717A" BorderThickness="2" CornerRadius="12" Padding="8" Margin="0,8,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#10B981" Opacity="0.22"/>
                                    </Border.Effect>
                                <Border Name="ItemLayoutFrame" Height="420" MinHeight="420" Margin="0,10,0,0" Background="#0F0F11" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="7" ClipToBounds="True" SizeChanged="ItemLayoutFrame_SizeChanged">
                                <Canvas Name="ItemLayoutCanvas">
                                <Canvas Name="LayoutGuideCanvas" Width="{Binding ActualWidth, ElementName=ItemLayoutFrame}" Height="{Binding ActualHeight, ElementName=ItemLayoutFrame}" IsHitTestVisible="False" Panel.ZIndex="0"/>
                                <ItemsControl Name="ItemRows" Width="{Binding ActualWidth, ElementName=ItemLayoutFrame}" Height="{Binding ActualHeight, ElementName=ItemLayoutFrame}" Panel.ZIndex="1">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding TileWidth}" Height="{Binding TileHeight}" Background="{Binding BoxColor}" CornerRadius="6"
                                                    RenderTransformOrigin="0.5,0.5" Tag="{Binding}" Cursor="Hand"
                                                    PreviewMouseLeftButtonDown="ItemTile_MouseLeftButtonDown" PreviewMouseMove="ItemTile_MouseMove" PreviewMouseLeftButtonUp="ItemTile_MouseLeftButtonUp">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{Binding OutlineColor}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActiveScan}" Value="True">
                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="7" ShadowDepth="0" Color="#60A5FA" Opacity="0.38"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsErrorFlash}" Value="True">
                                                                <Setter Property="BorderThickness" Value="3"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#EF4444" Opacity="0.95"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.RenderTransform><RotateTransform Angle="{Binding Rotation}"/></Border.RenderTransform>
                                                <Grid>
                                                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" Foreground="White" FontSize="15" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Margin="8,0" IsHitTestVisible="False" Visibility="{Binding EmptyNumberVisibility}"/>
                                                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Slot}" Background="Transparent" BorderThickness="0" Foreground="#111827"
                                                             FontSize="12" FontWeight="Bold" TextWrapping="Wrap" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="9,3"
                                                             VerticalAlignment="Stretch"
                                                             IsReadOnly="{Binding IsLayoutEditing}" KeyDown="ItemTextBox_KeyDown" GotKeyboardFocus="ScanTextBox_GotKeyboardFocus">
                                                    <TextBox.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{Binding PlacementTarget.DataContext.Code, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="False" />
                                                            <MenuItem Header="{Binding PlacementTarget.DataContext.DisplayName, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="False" />
                                                            <MenuItem Header="Update item" Click="UpdateItem_Click" Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </TextBox.ContextMenu>
                                                    </TextBox>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                    <Border Name="ProductIdTile" Width="120" Height="44" Background="#4C1D95" BorderBrush="#A78BFA" BorderThickness="1" CornerRadius="6" Panel.ZIndex="2"
                                            Cursor="Hand" PreviewMouseLeftButtonDown="ProductIdTile_MouseLeftButtonDown" PreviewMouseMove="ProductIdTile_MouseMove" PreviewMouseLeftButtonUp="ProductIdTile_MouseLeftButtonUp">
                                        <Grid>
                                            <TextBlock Text="ID" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=TxtProductQr}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Name="TxtProductQr" Background="Transparent" BorderThickness="0" Foreground="White"
                                                     FontSize="11" FontWeight="Bold" TextWrapping="Wrap" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="7"
                                                     IsReadOnly="True" IsHitTestVisible="False" TextChanged="TxtProductQr_TextChanged"/>
                                        </Grid>
                                    </Border>
                                </Canvas>
                                </Border>
                                </Border>
                                <TextBlock Text="Chọn Model → quét barcode sản phẩm → quét item có đúng tiền tố barcode của model/slot → Gửi. BOM không tạo sẵn sản phẩm." Foreground="#A1A1AA" FontSize="11" Margin="4,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

                <Border Name="ServerDetailPanel" Grid.Column="2" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="CHI TIẾT SERVER" Foreground="#C4B5FD" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Name="ProductDetailText" Text="Chưa có sản phẩm được chọn" Foreground="#A1A1AA" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,10"/>
                            <ItemsControl Name="BarcodeCards">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10" Background="Transparent">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{Binding Code}" IsEnabled="False" />
                                                    <MenuItem Header="{Binding Caption}" IsEnabled="False" />
                                                    <MenuItem Header="Update item" Click="UpdateServerItem_Click" Tag="{Binding}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Caption}" Foreground="#E4E4E7" FontSize="10" FontWeight="SemiBold"/>
                                            <Border Grid.Row="1" Background="#F4F4F5" CornerRadius="4" Padding="4" Margin="0,4,0,0" ToolTip="Click phải chuột để cập nhật">
                                                <Image Source="{Binding Image}" Height="42" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Row="2" Text="{Binding Code}" Foreground="#71717A" FontSize="9" Margin="5,3,5,0" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="#27272A" BorderThickness="0,1,0,0" Margin="0,6,0,10"/>
                            <Grid>
                                <TextBlock Text="LỊCH SỬ SCAN" Foreground="#34D399" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ToggleButton Name="ToggleHistorySection" IsChecked="False" Click="ToggleHistorySection_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="#27272A" CornerRadius="5" Padding="10,4">
                                                            <TextBlock Text="{TemplateBinding Content}" Foreground="#A1A1AA" FontSize="12"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Content" Value="━"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="👁"/></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </Grid>
                            <ItemsControl Name="HistoryList" Margin="0,10,0,0" Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#121214" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,5">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProductTitle}" Foreground="#C4B5FD" FontSize="9" FontWeight="Bold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                                <ItemsControl ItemsSource="{Binding ScannedItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,4">
                                                                <TextBlock Text="{Binding Name}" Foreground="#A1A1AA" FontSize="9" FontWeight="Bold"/>
                                                                <Border Background="#10B981" CornerRadius="3" Padding="4,4" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding Code}" Foreground="Black" FontWeight="Bold" FontSize="9" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
        </Grid>
    </Grid>
</UserControl>
