<UserControl x:Class="SoncaAudioInspector.QrScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#0E0E10" Foreground="#E4E4E7" Loaded="Window_Loaded" Unloaded="Window_Unloaded">
    <UserControl.Resources>
        <Style x:Key="QrButtonBase" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#71717A"/>
                    <Setter Property="Background" Value="#1F1F22"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QrScanButtonStyle" TargetType="Button" BasedOn="{StaticResource QrButtonBase}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#60A5FA"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="QrActionButtonStyle" TargetType="Button" BasedOn="{StaticResource QrButtonBase}">
            <Setter Property="Background" Value="#27272A"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3F3F46"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="QrSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource QrButtonBase}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#06130F"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#34D399"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ScanTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="4"/>
                            <Border x:Name="focusBorder" BorderBrush="White" BorderThickness="1.5" CornerRadius="4" Opacity="0"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focusBorder" Property="Opacity" Value="1"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="BlinkStoryboard">
                                        <Storyboard>
                                            <DoubleAnimation 
                                                Storyboard.TargetName="focusBorder" 
                                                Storyboard.TargetProperty="Opacity"
                                                From="0" To="1" Duration="0:0:0.2" 
                                                AutoReverse="True" RepeatBehavior="3x"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="BlinkStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Overlay Dialog for Update Item -->
        <Border Name="UpdateItemOverlay" Grid.RowSpan="3" Background="#90000000" Panel.ZIndex="100" Visibility="Collapsed">
            <Border Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="CẬP NHẬT BARCODE ITEM" Foreground="#C4B5FD" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="Mã cũ:" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Name="TxtOldItemCode" Height="38" Background="#27272A" Foreground="#71717A" BorderThickness="0" Padding="10,5" VerticalContentAlignment="Center" IsReadOnly="True" Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Mã mới:" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Name="TxtNewItemCode" Height="38" Background="#18181B" Foreground="White" BorderBrush="#3B82F6" BorderThickness="1" Padding="10,5" VerticalContentAlignment="Center" Margin="0,0,0,20"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Style="{StaticResource QrActionButtonStyle}" Click="BtnCancelUpdateItem_Click"/>
                        <Button Name="BtnConfirmUpdateItem" Grid.Column="2" Content="Confirm" Style="{StaticResource QrScanButtonStyle}" Click="BtnConfirmUpdateItem_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Moved above UpdateItemOverlay to fix MC3088 -->
        <Border Name="UpdateItemOverlayPlaceholder" Visibility="Collapsed" />

        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="16,11">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="QUÉT SẢN PHẨM VÀ ITEM" FontSize="13" FontWeight="Bold" Foreground="#F4F4F5"/>
                    <TextBlock Text="Quét bằng scanner USB hoặc camera điện thoại qua DroidCam." Margin="0,4,0,0" FontSize="11" Foreground="#A1A1AA"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,7,0"/>
                    <TextBlock Name="TxtScanStatus" Text="Sẵn sàng" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,11,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Nguồn" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Name="SourceCombo" Width="125" Height="30" SelectedIndex="0" Margin="0,0,10,0"
                              Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="SourceCombo_SelectionChanged">
                        <ComboBoxItem Content="DroidCam"/>
                        <ComboBoxItem Content="USB Camera 0"/>
                        <ComboBoxItem Content="USB Camera 1"/>
                    </ComboBox>
                    <StackPanel Name="IpPanel" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="IP" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Name="DeviceIPText" Text="192.168.11.140" Width="115" Height="30" Margin="0,0,7,0"/>
                        <TextBlock Text="Port" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Name="DevicePortText" Text="4747" Width="52" Height="30" Margin="0,0,7,0"/>
                        <TextBlock Text="Path" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Name="DevicePathText" Text="/video" Width="62" Height="30"/>
                    </StackPanel>
                    <Button Name="BtnCameraConnect" Content="Connect camera" Width="120" Style="{StaticResource QrScanButtonStyle}" Click="ConnectButton_Click" Margin="0,0,7,0"/>
                    <Button Name="BtnCameraDisconnect" Content="Disconnect" Width="105" Style="{StaticResource QrActionButtonStyle}" IsEnabled="False" Click="DisconnectButton_Click" Margin="0,0,12,0"/>
                    <TextBlock Name="CameraStatusLabel" Text="Offline" Foreground="#F87171" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Active Scan Area -->
                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <Grid>
                                <TextBlock Name="TxtScanCounter" Text="SCAN" Foreground="#34D399" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Name="BtnCreateBarcode" Content="In mã" Width="120" Margin="0,0,10,0" Style="{StaticResource QrActionButtonStyle}" Click="BtnCreateBarcode_Click"/>
                                    <Button Name="BtnConfirm" Content="Gửi lên server" Width="130" Margin="0,0,10,0" Style="{StaticResource QrSuccessButtonStyle}" Click="BtnConfirm_Click"/>
                                    <Button Content="Hủy" Width="70" Margin="0,0,0,0" Style="{StaticResource QrActionButtonStyle}" Click="BtnCancel_Click"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Name="ActiveScanPanel" Margin="0,10,0,0">
                                <Grid MinHeight="48" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="SẢN PHẨM / BARCODE" Foreground="#C4B5FD" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBox Name="TxtProductQr" Grid.Column="1" Height="38" Margin="14,0,12,0"
                                             Background="#27272A" Style="{StaticResource ScanTextBoxStyle}"
                                             KeyDown="TxtProductQr_KeyDown"/>
                                </Grid>
                                <Border BorderBrush="#27272A" BorderThickness="0,0,0,1" Margin="0,0,0,10"/>

                                <ItemsControl Name="ItemRows">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="64" Margin="12,8,12,12" Width="170">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#A1A1AA" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                                <TextBox Grid.Row="1" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Slot}" Height="44"
                                                         Background="{Binding BoxColor}" Style="{StaticResource ScanTextBoxStyle}" Foreground="Black" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                         KeyDown="ItemTextBox_KeyDown">
                                                    <TextBox.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{Binding PlacementTarget.DataContext.Code, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="False" />
                                                            <MenuItem Header="{Binding PlacementTarget.DataContext.DisplayName, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="False" />
                                                            <MenuItem Header="Update item" Click="UpdateItem_Click" Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </TextBox.ContextMenu>
                                                </TextBox>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- History Section Header -->
                    <Grid Margin="0,15,0,0">
                        <TextBlock Text="LỊCH SỬ SCAN" Foreground="#34D399" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        <ToggleButton Name="ToggleHistorySection" IsChecked="False" Click="ToggleHistorySection_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="#27272A" CornerRadius="6" Padding="14,6">
                                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#A1A1AA" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Content" Value="━"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="👁"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>

                    <!-- History List -->
                    <ItemsControl Name="HistoryList" Margin="0,10,0,0" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#121214" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ProductTitle}" Foreground="#C4B5FD" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{Binding ScannedItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,10,10" Width="140">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding Name}" Foreground="#A1A1AA" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                                        <Border Grid.Row="1" Background="#10B981" CornerRadius="4" Padding="5,10">
                                                            <TextBlock Text="{Binding Code}" Foreground="Black" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="1.1*"/><RowDefinition Height="12"/><RowDefinition Height="1.2*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="8">
                    <Grid>
                        <Image Name="CameraFeedImage" Stretch="Uniform"/>
                        <TextBlock Name="NoCameraText" Text="Camera preview&#x0a;Kết nối DroidCam để scan" TextAlignment="Center" Foreground="#52525B" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Background="#18181B" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                            <TextBlock Text="BARCODE CAMERA" Foreground="#A1A1AA" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="CHI TIẾT SERVER" Foreground="#C4B5FD" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Name="ProductDetailText" Text="Chưa có sản phẩm được chọn" Foreground="#A1A1AA" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,10"/>
                            <ItemsControl Name="BarcodeCards">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10" Background="Transparent">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{Binding Code}" IsEnabled="False" />
                                                    <MenuItem Header="{Binding Caption}" IsEnabled="False" />
                                                    <MenuItem Header="Update item" Click="UpdateServerItem_Click" Tag="{Binding}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Caption}" Foreground="#E4E4E7" FontSize="10" FontWeight="SemiBold"/>
                                            <Border Grid.Row="1" Background="#F4F4F5" CornerRadius="4" Padding="4" Margin="0,4,0,0" ToolTip="Click phải chuột để cập nhật">
                                                <Image Source="{Binding Image}" Height="42" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Row="2" Text="{Binding Code}" Foreground="#71717A" FontSize="9" Margin="5,3,5,0" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Camera tự điền vào ô đang chọn · scanner USB cần Enter để chuyển ô." Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
