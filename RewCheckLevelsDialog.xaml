<Window x:Class="SoncaAudioInspector.RewCheckLevelsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SoncaAudioInspector"
        Title="REW Check Levels - Kiểm tra âm lượng IN / OUT"
        SizeToContent="Height"
        Width="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Icon="pack://application:,,,/Assets/app_icon.ico">

    <Border x:Name="RootBorder" Background="#141416" 
            CornerRadius="12" 
            BorderThickness="1.5" 
            BorderBrush="#27272A" 
            Margin="15">
        <Border.Effect>
            <DropShadowEffect x:Name="RootDropShadow" BlurRadius="22" 
                              ShadowDepth="0" 
                              Color="#10B981" 
                              Opacity="0.35"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header -->
                <RowDefinition Height="Auto"/> <!-- 1: Dual Column In/Out -->
                <RowDefinition Height="Auto"/> <!-- 2: Evaluation Banner -->
                <RowDefinition Height="Auto"/> <!-- 3: Actions -->
            </Grid.RowDefinitions>

            <!-- 0: Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="Hand" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#064E3B" Margin="0,0,12,0">
                    <TextBlock Text="⚡" FontSize="20" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="KIỂM TRA MỨC ÂM LƯỢNG IN / OUT (CHECK LEVELS)" FontSize="15" FontWeight="Bold" Foreground="#F4F4F5"/>
                    <TextBlock Text="Cân chỉnh mức phát (Out) và mức thu mic (In) theo chuẩn Room EQ Wizard (REW)" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Click="BtnClose_Click" Width="28" Height="28" 
                        Background="Transparent" Foreground="#71717A" BorderThickness="0" FontSize="14" Cursor="Hand" VerticalAlignment="Top"/>
            </Grid>

            <!-- 1: Dual Column In/Out Section -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: OUTPUT (NGÕ PHÁT - OUT) -->
                <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <!-- Header badge -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="🔊 OUTPUT (NGÕ PHÁT)" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
                            <TextBlock x:Name="TxtOutActiveTag" Text="ĐANG PHÁT" FontSize="10" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Device Name -->
                        <TextBlock x:Name="TxtPlaybackDeviceName" Text="Loa / Soundcard" FontSize="11" Foreground="#D4D4D8" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                        <!-- Signal Selector -->
                        <TextBlock Text="Tín hiệu kiểm tra:" FontSize="10" Foreground="#71717A" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ComboSignalType" Height="28" Background="#121214" Foreground="#FFFFFF" BorderBrush="#3F3F46" Margin="0,0,0,6" SelectionChanged="ComboSignalType_SelectionChanged">
                            <ComboBoxItem Content="Pink Noise (REW Pink PN)" IsSelected="True"/>
                            <ComboBoxItem Content="Sine Wave 1,000 Hz"/>
                        </ComboBox>

                        <!-- Output Channel Selector -->
                        <TextBlock Text="Kênh phát (Output Channel):" FontSize="10" Foreground="#71717A" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ComboOutChannel" Height="28" Background="#121214" Foreground="#FFFFFF" BorderBrush="#3F3F46" Margin="0,0,0,10" SelectionChanged="ComboOutChannel_SelectionChanged">
                            <ComboBoxItem Content="Cả 2 kênh (Left + Right)" IsSelected="True"/>
                            <ComboBoxItem Content="Kênh Trái (Left / Kênh 1) - Mic 1"/>
                            <ComboBoxItem Content="Kênh Phải (Right / Kênh 2) - Mic 2"/>
                        </ComboBox>

                        <!-- Output Generator Level Slider -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Mức phát (Generator Level):" FontSize="10" Foreground="#71717A"/>
                            <TextBlock x:Name="TxtGenLevelValue" Text="-12.0 dBFS" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderGenLevel" Minimum="-60" Maximum="0" Value="-12" SmallChange="1" LargeChange="3"
                                VerticalAlignment="Center" Margin="0,0,0,10" ValueChanged="SliderGenLevel_ValueChanged"/>

                        <!-- Windows Master Playback Volume (read-only) -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Master Volume (0–100%, chỉ đọc):" FontSize="10" Foreground="#71717A"/>
                            <TextBlock x:Name="TxtWinOutVolValue" Text="--" FontSize="11" FontWeight="Bold" Foreground="#FACC15" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Output Level VU Meter -->
                        <TextBlock Text="Mức phát ước tính (Out dBFS):" FontSize="10" Foreground="#71717A" Margin="0,0,0,4"/>
                        <Grid Height="14" Margin="0,0,0,4">
                            <Border Background="#121214" CornerRadius="3"/>
                            <ProgressBar x:Name="BarOutMeter" Minimum="-60" Maximum="0" Value="-12" Height="14"
                                         Foreground="#38BDF8" Background="Transparent" BorderThickness="0"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="-60" FontSize="8" Foreground="#52525B" HorizontalAlignment="Left"/>
                            <TextBlock Text="-30" FontSize="8" Foreground="#52525B" HorizontalAlignment="Left" Margin="70,0,0,0"/>
                            <TextBlock Text="-12" FontSize="8" Foreground="#52525B" HorizontalAlignment="Right" Margin="0,0,45,0"/>
                            <TextBlock Text="0 dBFS" FontSize="8" Foreground="#52525B" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RIGHT: INPUT (NGÕ THU / MICRO - IN) -->
                <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <!-- Header badge -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="🎙 INPUT (NGÕ THU / MIC)" FontWeight="Bold" FontSize="12" Foreground="#10B981"/>
                            <TextBlock x:Name="TxtInStatusBadge" Text="---" FontSize="10" FontWeight="Bold" Foreground="#A1A1AA" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Device Name -->
                        <TextBlock x:Name="TxtRecordingDeviceName" Text="Microphone" FontSize="11" Foreground="#D4D4D8" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                        <!-- Input Channel Selector -->
                        <TextBlock Text="Kênh thu (Input Channel):" FontSize="10" Foreground="#71717A" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ComboInChannel" Height="28" Background="#121214" Foreground="#FFFFFF" BorderBrush="#3F3F46" Margin="0,0,0,10" SelectionChanged="ComboInChannel_SelectionChanged">
                            <ComboBoxItem Content="Cả 2 Mic (Trộn mono)" IsSelected="True"/>
                            <ComboBoxItem Content="Mic 1 (Kênh Trái / Left)"/>
                            <ComboBoxItem Content="Mic 2 (Kênh Phải / Right)"/>
                        </ComboBox>

                        <!-- Windows Mic Recording Level (read-only) -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Độ nhạy mic Windows (chỉ đọc):" FontSize="10" Foreground="#71717A"/>
                            <TextBlock x:Name="TxtWinInVolValue" Text="--" FontSize="11" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- REW Realtime Strip Chart Meter (0..-90 dB, Headroom Readout) -->
                        <local:RewRealtimeLevelMeter x:Name="RewMeterDialog" Margin="0,0,0,10"/>

                        <!-- Live Input dBFS Meter -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Đo mức tín hiệu thu thực tế (In dBFS):" FontSize="10" Foreground="#71717A"/>
                            <TextBlock x:Name="TxtInMeterValue" Text="-- dBFS" FontSize="11" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Visual Multi-Zone VU Bar -->
                        <Grid Height="18" Margin="0,0,0,2">
                            <!-- Background color zones -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30*"/> <!-- -60 to -30: Low -->
                                    <ColumnDefinition Width="10*"/> <!-- -30 to -20: Fair -->
                                    <ColumnDefinition Width="14*"/> <!-- -20 to -6: Target REW -->
                                    <ColumnDefinition Width="5*"/>  <!-- -6 to -1: High -->
                                    <ColumnDefinition Width="1*"/>  <!-- -1 to 0: Clip -->
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#27272A" CornerRadius="3,0,0,3"/>
                                <Border Grid.Column="1" Background="#3F3F46"/>
                                <Border Grid.Column="2" Background="#064E3B"/>
                                <Border Grid.Column="3" Background="#78350F"/>
                                <Border Grid.Column="4" Background="#7F1D1D" CornerRadius="0,3,3,0"/>
                            </Grid>
                            <!-- Live Meter Progress -->
                            <ProgressBar x:Name="BarInMeter" Minimum="-60" Maximum="0" Value="-60" Height="18"
                                         Foreground="#10B981" Background="Transparent" BorderThickness="0" Opacity="0.85"/>
                        </Grid>

                        <!-- Ticks & Target label -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="-60" FontSize="8" Foreground="#52525B" HorizontalAlignment="Left"/>
                            <TextBlock Text="-30" FontSize="8" Foreground="#52525B" HorizontalAlignment="Left" Margin="70,0,0,0"/>
                            <TextBlock Text="-20" FontSize="8" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Left" Margin="95,0,0,0"/>
                            <TextBlock Text="TARGET (-20..-6)" FontSize="7" Foreground="#10B981" HorizontalAlignment="Left" Margin="115,0,0,0"/>
                            <TextBlock Text="-6" FontSize="8" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,25,0"/>
                            <TextBlock Text="0 dBFS" FontSize="8" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 4-Stat Live Readout -->
                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock Text="ĐỈNH PEAK" FontSize="9" Foreground="#71717A"/>
                                <TextBlock x:Name="TxtInPeak" Text="--- dBFS" FontSize="12" FontWeight="Bold" Foreground="#F4F4F5"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="RMS LEVEL" FontSize="9" Foreground="#71717A"/>
                                <TextBlock x:Name="TxtInRms" Text="--- dBFS" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="HEADROOM" FontSize="9" Foreground="#71717A"/>
                                <TextBlock x:Name="TxtInHeadroom" Text="--- dB" FontSize="12" FontWeight="Bold" Foreground="#FACC15"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="SNR TÍN HIỆU" FontSize="9" Foreground="#71717A"/>
                                <TextBlock x:Name="TxtInSnr" Text="--- dB" FontSize="12" FontWeight="Bold" Foreground="#A78BFA"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2: REW Level Diagnostic Evaluation Banner -->
            <Border x:Name="BorderEval" Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtEvalIcon" Grid.Column="0" Text="ℹ" FontSize="22" Foreground="#38BDF8" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtEvalTitle" Text="ĐANG ĐO KIỂM MỨC ÂM THANH IN / OUT..." FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock x:Name="TxtEvalDesc" Text="Hãy điều chỉnh âm lượng phát hoặc độ nhạy micro để kim ngõ thu (In) nằm trọn trong vùng màu xanh (-20 dBFS đến -6 dBFS)." FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3: Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnPlayStop" Content="⏹ TẠM DỪNG PHÁT" Click="BtnPlayStop_Click"
                        Background="#27272A" Foreground="#F4F4F5" BorderBrush="#3F3F46" BorderThickness="1"
                        Height="38" Padding="14,0" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" x:Name="BtnClose" Content="ĐÓNG (CLOSE)" Click="BtnClose_Click"
                        Background="#27272A" Foreground="#A1A1AA" BorderBrush="#3F3F46" BorderThickness="1"
                        Height="38" Padding="16,0" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,8,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="3" x:Name="BtnStartMeasureNow" Content="▶ TIẾP TỤC ĐO SWEEP NGAY" Click="BtnStartMeasureNow_Click"
                        Background="#10B981" Foreground="#000000" BorderThickness="0"
                        Height="38" Padding="18,0" Cursor="Hand" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
