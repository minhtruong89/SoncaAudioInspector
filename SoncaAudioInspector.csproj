<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != 'win-x86'">x64</PlatformTarget>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <!-- Keep generated WPF sources excluded when building into an isolated intermediate directory. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**;.codex-obj*\**;.codex-bin-*\**;.artifacts*\**;artifacts*\**;demo-builds\**;bin-*\**;obj-*\**;hardware-channel-fix\**;scratch\**</DefaultItemExcludes>
    <DefineConstants Condition="'$(RuntimeIdentifier)' == 'win-x86'">$(DefineConstants);WIN_X86</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CheckApp\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="VisualAI.xaml.cs" />
    <Compile Remove="VisualAI.x86.xaml.cs" />
    <Compile Remove="AiVisualization\**\*.cs" />
    <None Remove="CheckApp\**\*" />
    <None Remove="tools\**\*" />
    <Page Remove="CheckApp\**\*.xaml" />
    <Page Remove="tools\**\*.xaml" />
    <Page Remove="VisualAI.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.Win32.Registry.AccessControl" Version="9.0.6" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.58" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.6" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app_icon.ico" />
    <Content Include="Assets\Audio\sine-1000Hz-minus12dBFS-RMS.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="checking_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="calibrations\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="FEEDBACK_SHIFT_GUIDE.vi.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="FEEDBACK_SHIFT_REVIEW.vi.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="PortableReadme.txt" Condition="'$(RuntimeIdentifier)' != 'win-x86'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="PortableReadme-x86.txt" Condition="'$(RuntimeIdentifier)' == 'win-x86'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <TargetPath>PortableReadme.txt</TargetPath>
    </Content>
    <Content Include="FastTrackPro_x64 Driver.rar" Condition="'$(RuntimeIdentifier)' != 'win-x86'">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>drivers\FastTrackPro_x64 Driver.rar</TargetPath>
    </Content>
  </ItemGroup>

</Project>
