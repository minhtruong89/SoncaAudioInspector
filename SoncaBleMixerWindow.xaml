<Window x:Class="SoncaAudioInspector.SoncaBleMixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sonca Mixer Studio Console" Width="920" Height="540" MinWidth="840" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#0B0D13" Foreground="#F4F4F5">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0D13"/>
        <SolidColorBrush x:Key="BgPanel" Color="#12151E"/>
        <SolidColorBrush x:Key="BorderDark" Color="#222736"/>
        <SolidColorBrush x:Key="CyanAccent" Color="#00E5FF"/>
        <SolidColorBrush x:Key="GreenAccent" Color="#10B981"/>
        <SolidColorBrush x:Key="AmberAccent" Color="#FFB830"/>

        <!-- Vertical Fader Slider Style matching Sonca Mixer Phone App -->
        <Style x:Key="VerticalFaderThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="34" Height="22" CornerRadius="3"
                                Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="1">
                            <Grid>
                                <!-- Center Groove of Fader Knob -->
                                <Rectangle Width="14" Height="2" Fill="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalFaderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <!-- Track Line -->
                            <Rectangle Width="2" Fill="#475569" HorizontalAlignment="Center"
                                       Margin="0,11,0,11"/>
                            <!-- Track Fill (Active lower part) -->
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource VerticalFaderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Locked Vertical Fader Style (Hardware Knob Only - Mute/Unmute Allowed) -->
        <Style x:Key="LockedVerticalFaderThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="34" Height="22" CornerRadius="3"
                                Background="#334155" BorderBrush="#1E293B" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="🔒" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LockedVerticalFaderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Cursor" Value="No"/>
            <Setter Property="ToolTip" Value="Khóa phần mềm: Chỉ cho phép Bật/Tắt tiếng. Bắt buộc chỉnh tăng/giảm âm lượng bằng nút vật lý trên loa."/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center" Opacity="0.75">
                            <Rectangle Width="2" Fill="#334155" HorizontalAlignment="Center" Margin="0,11,0,11"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource LockedVerticalFaderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch Style (iOS/Android Pill Look) -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SwitchBorder" Width="42" Height="22" CornerRadius="11"
                                Background="#334155" BorderBrush="#475569" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="SwitchKnob" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,1,0,1">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#10B981"/>
                                <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="#059669"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchKnob" Property="Margin" Value="0,1,2,1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input Source Radio Button Style with dot indicator on the right -->
        <Style x:Key="InputRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ItemBorder" Background="Transparent" Padding="8,4" CornerRadius="4">
                            <DockPanel LastChildFill="True">
                                <!-- Dot indicator on right -->
                                <Border x:Name="DotOuter" DockPanel.Dock="Right" Width="16" Height="16" CornerRadius="8"
                                        BorderBrush="#475569" BorderThickness="1.5" Background="Transparent" VerticalAlignment="Center">
                                    <Ellipse x:Name="DotInner" Width="8" Height="8" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E2230"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#00E5FF"/>
                                <Setter TargetName="DotOuter" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter TargetName="DotInner" Property="Fill" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/> <!-- Custom Title Bar -->
            <RowDefinition Height="*"/>  <!-- Unified Mixer Surface -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. TITLE BAR ==================== -->
        <Border Grid.Row="0" Background="#12151E" BorderBrush="#222736" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SONCA" FontSize="13" FontWeight="Black" Foreground="#FFB830" Margin="0,0,4,0"/>
                    <TextBlock Text="MIXER CONSOLE" FontSize="13" FontWeight="Bold" Foreground="#00E5FF"/>
                </StackPanel>

                <!-- Status & Target Model -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🔒 Chỉ cho phép chỉnh âm lượng MIC (các kênh khác chỉnh trực tiếp nút trên loa)" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,16,0"/>
                    <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="#EF4444" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtStatus" Text="Chưa kết nối" FontSize="11" Foreground="#94A3B8" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtTargetModelIndicator" Text="Model: Auto-Detect" FontSize="11" Foreground="#64748B"/>
                </StackPanel>

                <!-- Window Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="—" Width="30" Height="24" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                            Click="BtnMinimize_Click" Cursor="Hand" ToolTip="Thu nhỏ"/>
                    <Button Content="✕" Width="30" Height="24" Background="Transparent" Foreground="#EF4444" BorderThickness="0"
                            Click="BtnClose_Click" Cursor="Hand" ToolTip="Đóng"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN UNIFIED MIXER SURFACE ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>      <!-- Left & Center: 6 Faders -->
                <ColumnDefinition Width="1"/>      <!-- Divider -->
                <ColumnDefinition Width="220"/>    <!-- Right: Inputs, Switches, Presets & Settings -->
            </Grid.ColumnDefinitions>

            <!-- ==================== 2.1 SIX VERTICAL FADERS ==================== -->
            <Grid Grid.Column="0" Margin="10,8,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/> <!-- Fader 1: MIC (Điều chỉnh được) -->
                    <ColumnDefinition Width="*"/> <!-- Fader 2: ECHO (Khóa - Chỉ chỉnh nút loa) -->
                    <ColumnDefinition Width="*"/> <!-- Fader 3: REVERB (Khóa - Chỉ chỉnh nút loa) -->
                    <ColumnDefinition Width="*"/> <!-- Fader 4: MUSIC (Khóa - Chỉ chỉnh nút loa) -->
                    <ColumnDefinition Width="*"/> <!-- Fader 5: MASTER (Khóa - Chỉ chỉnh nút loa) -->
                    <ColumnDefinition Width="*"/> <!-- Fader 6: LIVE (Khóa - Chỉ chỉnh nút loa) -->
                </Grid.ColumnDefinitions>

                <!-- 1. MIC FADER (CHO PHÉP TĂNG GIẢM ÂM LƯỢNG) -->
                <Grid Grid.Column="0" Margin="4,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/> <!-- Header: Name & Value -->
                        <RowDefinition Height="*"/>  <!-- Slider & Scale -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="MIC" FontSize="13" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" ToolTip="Cho phép kéo tăng/giảm âm lượng"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtMicVal" Text="50" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,4,0"/>
                            <Button x:Name="BtnMuteMic" Content="🔊" Width="20" Height="18" Padding="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0" Foreground="#10B981" Cursor="Hand"
                                    Click="BtnMuteChannel_Click" Tag="Mic" ToolTip="Tắt tiếng Micro"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,8" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/> <!-- Scale text -->
                            <ColumnDefinition Width="Auto"/> <!-- Slider -->
                        </Grid.ColumnDefinitions>
                        <!-- Scale Numbers & Ticks -->
                        <Grid Grid.Column="0" VerticalAlignment="Stretch" Margin="0,11,4,11">
                            <TextBlock Text="100" FontSize="10" Foreground="#64748B" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                            <TextBlock Text="75" FontSize="10" Foreground="#64748B" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,68,0,0"/>
                            <TextBlock Text="50" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock Text="25" FontSize="10" Foreground="#64748B" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,68"/>
                            <TextBlock Text="0" FontSize="10" Foreground="#64748B" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderMicVol" Grid.Column="1" Style="{StaticResource VerticalFaderStyle}"
                                Minimum="0" Maximum="100" Value="50" ValueChanged="Slider_ValueChanged"
                                ToolTip="Mức Micro 0–100 theo thang Sonca Mixer"/>
                    </Grid>
                </Grid>

                <!-- 2. ECHO FADER (KHÓA - CHỈ BẬT/TẮT TIẾNG) -->
                <Grid Grid.Column="1" Margin="4,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="ECHO 🔒" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"
                                   ToolTip="Khóa phần mềm: Chỉ chỉnh tăng/giảm âm lượng bằng nút trên loa"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtEchoVal" Text="46" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,4,0"/>
                            <Button x:Name="BtnMuteEcho" Content="🔊" Width="20" Height="18" Padding="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0" Foreground="#10B981" Cursor="Hand"
                                    Click="BtnMuteChannel_Click" Tag="Echo" ToolTip="Bật / Tắt tiếng Echo"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,8" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Stretch" Margin="0,11,4,11">
                            <TextBlock Text="100" FontSize="10" Foreground="#475569" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                            <TextBlock Text="75" FontSize="10" Foreground="#475569" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,68,0,0"/>
                            <TextBlock Text="50" FontSize="10" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock Text="25" FontSize="10" Foreground="#475569" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,68"/>
                            <TextBlock Text="0" FontSize="10" Foreground="#475569" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderEcho" Grid.Column="1" Style="{StaticResource LockedVerticalFaderStyle}"
                                Minimum="0" Maximum="100" Value="46"/>
                    </Grid>
                </Grid>

                <!-- 3. REVERB FADER (KHÓA - CHỈ BẬT/TẮT TIẾNG) -->
                <Grid Grid.Column="2" Margin="4,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="REVERB 🔒" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"
                                   ToolTip="Khóa phần mềm: Chỉ chỉnh tăng/giảm âm lượng bằng nút trên loa"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtReverbVal" Text="45" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,4,0"/>
                            <Button x:Name="BtnMuteReverb" Content="🔊" Width="20" Height="18" Padding="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0" Foreground="#10B981" Cursor="Hand"
                                    Click="BtnMuteChannel_Click" Tag="Reverb" ToolTip="Bật / Tắt tiếng Reverb"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,8" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Stretch" Margin="0,11,4,11">
                            <TextBlock Text="100" FontSize="10" Foreground="#475569" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                            <TextBlock Text="75" FontSize="10" Foreground="#475569" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,68,0,0"/>
                            <TextBlock Text="50" FontSize="10" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock Text="25" FontSize="10" Foreground="#475569" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,68"/>
                            <TextBlock Text="0" FontSize="10" Foreground="#475569" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderReverb" Grid.Column="1" Style="{StaticResource LockedVerticalFaderStyle}"
                                Minimum="0" Maximum="100" Value="45"/>
                    </Grid>
                </Grid>

                <!-- 4. MUSIC FADER (KHÓA - CHỈ BẬT/TẮT TIẾNG) -->
                <Grid Grid.Column="3" Margin="4,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="MUSIC 🔒" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"
                                   ToolTip="Khóa phần mềm: Chỉ chỉnh tăng/giảm âm lượng bằng nút trên loa"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtMusicVal" Text="70" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,4,0"/>
                            <Button x:Name="BtnMuteMusic" Content="🔊" Width="20" Height="18" Padding="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0" Foreground="#10B981" Cursor="Hand"
                                    Click="BtnMuteChannel_Click" Tag="Music" ToolTip="Bật / Tắt tiếng Nhạc"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,8" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Stretch" Margin="0,11,4,11">
                            <TextBlock Text="100" FontSize="10" Foreground="#475569" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                            <TextBlock Text="75" FontSize="10" Foreground="#475569" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,68,0,0"/>
                            <TextBlock Text="50" FontSize="10" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock Text="25" FontSize="10" Foreground="#475569" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,68"/>
                            <TextBlock Text="0" FontSize="10" Foreground="#475569" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderMusicVol" Grid.Column="1" Style="{StaticResource LockedVerticalFaderStyle}"
                                Minimum="0" Maximum="100" Value="70"/>
                    </Grid>
                </Grid>

                <!-- 5. MASTER FADER (KHÓA - CHỈ BẬT/TẮT TIẾNG) -->
                <Grid Grid.Column="4" Margin="4,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="MASTER DSP 🔒" FontSize="12" FontWeight="Bold" Foreground="#FFB830" HorizontalAlignment="Center"
                                   ToolTip="Khóa phần mềm: Chỉ chỉnh tăng/giảm âm lượng bằng nút trên loa"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtMasterVal" Text="60" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,4,0"/>
                            <Button x:Name="BtnMuteMaster" Content="🔊" Width="20" Height="18" Padding="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0" Foreground="#10B981" Cursor="Hand"
                                    Click="BtnMuteChannel_Click" Tag="Master" ToolTip="Bật / Tắt âm lượng tổng"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,8" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Stretch" Margin="0,11,4,11">
                            <TextBlock Text="100" FontSize="10" Foreground="#475569" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                            <TextBlock Text="75" FontSize="10" Foreground="#475569" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,68,0,0"/>
                            <TextBlock Text="50" FontSize="10" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock Text="25" FontSize="10" Foreground="#475569" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,68"/>
                            <TextBlock Text="0" FontSize="10" Foreground="#475569" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderMasterVol" Grid.Column="1" Style="{StaticResource LockedVerticalFaderStyle}"
                                Minimum="0" Maximum="100" Value="60"/>
                    </Grid>
                </Grid>

                <!-- 6. LIVE FADER (KHÓA - CHỈ BẬT/TẮT TIẾNG) -->
                <Grid Grid.Column="5" Margin="4,0,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="LIVE 🔒" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center"
                                   ToolTip="Khóa phần mềm: Chỉ chỉnh tăng/giảm âm lượng bằng nút trên loa"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtLiveVal" Text="75" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,4,0"/>
                            <Button x:Name="BtnMuteLive" Content="🔊" Width="20" Height="18" Padding="0" FontSize="10"
                                    Background="Transparent" BorderThickness="0" Foreground="#10B981" Cursor="Hand"
                                    Click="BtnMuteChannel_Click" Tag="Live" ToolTip="Bật / Tắt Live Stream/Record"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,8" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Stretch" Margin="0,11,4,11">
                            <TextBlock Text="100" FontSize="10" Foreground="#475569" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                            <TextBlock Text="75" FontSize="10" Foreground="#475569" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,68,0,0"/>
                            <TextBlock Text="50" FontSize="10" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock Text="25" FontSize="10" Foreground="#475569" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,68"/>
                            <TextBlock Text="0" FontSize="10" Foreground="#475569" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderLiveVol" Grid.Column="1" Style="{StaticResource LockedVerticalFaderStyle}"
                                Minimum="0" Maximum="100" Value="75"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Vertical Divider -->
            <Rectangle Grid.Column="1" Fill="#1E2433"/>

            <!-- ==================== 2.2 RIGHT PANEL (INPUTS, TOGGLES, SETTINGS) ==================== -->
            <Grid Grid.Column="2" Background="#10131B" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Preset Button -->
                    <RowDefinition Height="*"/>    <!-- Inputs & Switches -->
                    <RowDefinition Height="Auto"/> <!-- Settings Button -->
                </Grid.RowDefinitions>

                <!-- Preset Mode Button -->
                <Border Grid.Row="0" Margin="14,14,14,8">
                    <Button x:Name="BtnPreset" Content="ACOUSTIC STANDARD ▾" Height="34"
                            Background="#181D29" Foreground="#00E5FF" BorderBrush="#2A3245" BorderThickness="1"
                            FontWeight="Bold" FontSize="11.5" Cursor="Hand" Click="BtnPreset_Click">
                        <Button.ContextMenu>
                            <ContextMenu Background="#181D29" Foreground="White">
                                <MenuItem Header="Acoustic Standard" Click="MenuPreset_Click" Tag="Acoustic"/>
                                <MenuItem Header="Karaoke Tiêu chuẩn" Click="MenuPreset_Click" Tag="Karaoke"/>
                                <MenuItem Header="Sân khấu (Stage)" Click="MenuPreset_Click" Tag="Stage"/>
                                <MenuItem Header="Dance / Remix" Click="MenuPreset_Click" Tag="Dance"/>
                                <MenuItem Header="Bolero Vocal" Click="MenuPreset_Click" Tag="Bolero"/>
                                <MenuItem Header="Pop Trữ tình" Click="MenuPreset_Click" Tag="Pop"/>
                                <Separator Background="#2A3245"/>
                                <MenuItem Header="Đặt lại phẳng (Flat Reset)" Click="MenuPreset_Click" Tag="Flat"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Border>

                <!-- Input Sources & Toggles Scroll Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,0,14,6">
                    <StackPanel>
                        <!-- Section: Ngõ vào -->
                        <TextBlock Text="Ngõ vào" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,6"/>

                        <RadioButton x:Name="RadioInputBt" Content="BT" Style="{StaticResource InputRadioStyle}"
                                     IsChecked="True" Checked="RadioInput_Checked" Tag="0"/>
                        <RadioButton x:Name="RadioInputUsb" Content="USB" Style="{StaticResource InputRadioStyle}"
                                     Checked="RadioInput_Checked" Tag="1"/>
                        <RadioButton x:Name="RadioInputOpt" Content="OPTICAL" Style="{StaticResource InputRadioStyle}"
                                     Checked="RadioInput_Checked" Tag="2"/>
                        <RadioButton x:Name="RadioInputHdmi" Content="HDMI" Style="{StaticResource InputRadioStyle}"
                                     Checked="RadioInput_Checked" Tag="3"/>
                        <RadioButton x:Name="RadioInputLineIn" Content="LINE IN" Style="{StaticResource InputRadioStyle}"
                                     Checked="RadioInput_Checked" Tag="4"/>
                        <RadioButton x:Name="RadioInputKaraoke" Content="KARAOKE" Style="{StaticResource InputRadioStyle}"
                                     Checked="RadioInput_Checked" Tag="5"/>

                        <Rectangle Height="1" Fill="#1E2433" Margin="0,10,0,10"/>

                        <!-- Section: Toggles / Switches -->
                        <Grid Margin="0,4,0,8">
                            <TextBlock Text="Mic FBX" FontSize="12.5" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkFbx" HorizontalAlignment="Right" Style="{StaticResource ModernToggleSwitch}"
                                      IsChecked="True" Click="ChkFbx_Click"/>
                        </Grid>

                        <Grid Margin="0,4,0,8">
                            <TextBlock Text="Bass boost" FontSize="12.5" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkBassBoost" HorizontalAlignment="Right" Style="{StaticResource ModernToggleSwitch}"
                                      IsChecked="False" Click="ChkBassBoost_Click"/>
                        </Grid>

                        <Grid Margin="0,4,0,8">
                            <TextBlock Text="Enhancer" FontSize="12.5" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkEnhancer" HorizontalAlignment="Right" Style="{StaticResource ModernToggleSwitch}"
                                      IsChecked="False" Click="ChkEnhancer_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom: Settings Button -->
                <Border Grid.Row="2" BorderBrush="#1E2433" BorderThickness="0,1,0,0" Padding="14,10">
                    <StackPanel>
                    <TextBlock x:Name="TxtPlaybackLevel" Text="Windows BT: —" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <Button x:Name="BtnOpenSettings" Content="⚙ Cài đặt" Height="32"
                            Background="#181D29" Foreground="#CBD5E1" BorderBrush="#2A3245" BorderThickness="1"
                            FontSize="12" Cursor="Hand" Click="BtnToggleSettings_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== 2.3 SLIDE-OUT SETTINGS DRAWER OVERLAY ==================== -->
            <Border x:Name="PanelSettings" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#EE0B0D13" BorderBrush="#00E5FF" BorderThickness="1,0,0,0"
                    HorizontalAlignment="Right" Width="440" Visibility="Collapsed">
                <Grid Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Drawer Header -->
                        <RowDefinition Height="*"/>    <!-- Settings Content -->
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28" Background="#1E2433"
                                Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnToggleSettings_Click"/>
                        <TextBlock Text="⚙ CÀI ĐẶT &amp; KẾT NỐI BLE" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 1. BLE Connection -->
                            <Border Background="#161A24" BorderBrush="#222A3A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="KẾT NỐI BLUETOOTH LE" FontSize="12" FontWeight="Bold" Foreground="#FFB830" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtAudioConnection" Text="Bluetooth Windows: đang kiểm tra..." Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock Text="Kết nối âm thanh Bluetooth và ngõ BLE điều khiển là hai kết nối riêng. Loa không phát tên vẫn được nhận qua dịch vụ Sonca 5343." Foreground="#94A3B8" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CmbDevices" Grid.Column="0" Height="30" Margin="0,0,6,0" SelectionChanged="CmbDevices_SelectionChanged"
                                                  Background="#1E2433" Foreground="White" BorderBrush="#2E384D"/>
                                        <Button x:Name="BtnScan" Grid.Column="1" Content="🔍 Quét" Width="70" Height="30"
                                                Background="#0284C7" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnScan_Click"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnConnect" Content="Kết nối" Width="85" Height="28" Margin="0,0,6,0"
                                                Background="#059669" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnConnect_Click"/>
                                        <Button x:Name="BtnDisconnect" Content="Ngắt kết nối" Width="95" Height="28"
                                                Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnDisconnect_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 2. Tone Controls (Music & Mic) -->
                            <Border Background="#161A24" BorderBrush="#222A3A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CÂN CHỈNH ÂM SẮC (TONE)" FontSize="12" FontWeight="Bold" Foreground="#FFB830" Margin="0,0,0,8"/>

                                    <TextBlock Text="Music Tone (Bass / Mid / Treble):" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,4"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Bass" VerticalAlignment="Center" FontSize="11" Foreground="#CBD5E1"/>
                                        <Slider x:Name="SliderMusicBass" Grid.Column="1" Minimum="-10" Maximum="10" Value="0" ValueChanged="SliderTone_ValueChanged"/>
                                        <TextBlock x:Name="TxtMusicBassVal" Grid.Column="2" Text="0 dB" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Mid" VerticalAlignment="Center" FontSize="11" Foreground="#CBD5E1"/>
                                        <Slider x:Name="SliderMusicMid" Grid.Column="1" Minimum="-10" Maximum="10" Value="0" ValueChanged="SliderTone_ValueChanged"/>
                                        <TextBlock x:Name="TxtMusicMidVal" Grid.Column="2" Text="0 dB" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Treble" VerticalAlignment="Center" FontSize="11" Foreground="#CBD5E1"/>
                                        <Slider x:Name="SliderMusicTreble" Grid.Column="1" Minimum="-10" Maximum="10" Value="0" ValueChanged="SliderTone_ValueChanged"/>
                                        <TextBlock x:Name="TxtMusicTrebleVal" Grid.Column="2" Text="0 dB" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                                    </Grid>

                                    <TextBlock Text="Mic Tone (Bass / Mid / Treble):" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,4"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Bass" VerticalAlignment="Center" FontSize="11" Foreground="#CBD5E1"/>
                                        <Slider x:Name="SliderMicBass" Grid.Column="1" Minimum="-10" Maximum="10" Value="0" ValueChanged="SliderTone_ValueChanged"/>
                                        <TextBlock x:Name="TxtMicBassVal" Grid.Column="2" Text="0 dB" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Mid" VerticalAlignment="Center" FontSize="11" Foreground="#CBD5E1"/>
                                        <Slider x:Name="SliderMicMid" Grid.Column="1" Minimum="-10" Maximum="10" Value="0" ValueChanged="SliderTone_ValueChanged"/>
                                        <TextBlock x:Name="TxtMicMidVal" Grid.Column="2" Text="0 dB" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Treble" VerticalAlignment="Center" FontSize="11" Foreground="#CBD5E1"/>
                                        <Slider x:Name="SliderMicTreble" Grid.Column="1" Minimum="-10" Maximum="10" Value="0" ValueChanged="SliderTone_ValueChanged"/>
                                        <TextBlock x:Name="TxtMicTrebleVal" Grid.Column="2" Text="0 dB" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. Hardware Memory & Reset -->
                            <Border Background="#161A24" BorderBrush="#222A3A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="BỘ NHỚ LOA (EEPROM)" FontSize="12" FontWeight="Bold" Foreground="#FFB830" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnSaveSpeakerConfig" Content="💾 Lưu vào loa" Width="100" Height="28" Margin="0,0,6,0"
                                                Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnSaveConfig_Click"/>
                                        <Button x:Name="BtnResetSpeakerConfig" Content="↺ Khôi phục gốc" Width="110" Height="28"
                                                Background="#475569" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnFactoryReset_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 4. Realtime Traffic Log -->
                            <Border Background="#161A24" BorderBrush="#222A3A" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="Xóa log" Width="60" Height="22" Background="#1E2433"
                                                Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" Click="BtnClearLog_Click"/>
                                        <TextBlock Text="NHẬT KÝ GIAO TIẾP BLE" FontSize="12" FontWeight="Bold" Foreground="#FFB830"/>
                                    </DockPanel>
                                    <TextBox x:Name="TxtTrafficLog" Height="100" Background="#0B0D13" Foreground="#10B981"
                                             FontFamily="Consolas" FontSize="10.5" BorderBrush="#222A3A"
                                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
