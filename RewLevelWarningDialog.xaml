<Window x:Class="SoncaAudioInspector.RewLevelWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cảnh báo mức tín hiệu REW"
        SizeToContent="Height"
        Width="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Icon="pack://application:,,,/Assets/app_icon.ico">

    <Border x:Name="RootBorder" Background="#141416" 
            CornerRadius="10" 
            BorderThickness="1.5" 
            BorderBrush="#EF4444" 
            Margin="15">
        <Border.Effect>
            <DropShadowEffect x:Name="RootDropShadow" BlurRadius="20" 
                              ShadowDepth="0" 
                              Color="#EF4444" 
                              Opacity="0.4"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header -->
                <RowDefinition Height="Auto"/> <!-- 1: Level Meter Gauge -->
                <RowDefinition Height="Auto"/> <!-- 2: 4-Column Stats -->
                <RowDefinition Height="Auto"/> <!-- 3: Impact description -->
                <RowDefinition Height="Auto"/> <!-- 4: Solutions list -->
                <RowDefinition Height="Auto"/> <!-- 5: Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 0: Header with Icon, Title & Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="Hand" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border x:Name="BadgeIconBorder" Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#3B1212" Margin="0,0,14,0">
                    <TextBlock x:Name="TxtIcon" Text="⚠" FontSize="22" Foreground="#EF4444" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                </Border>

                <!-- Titles -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="CẢNH BÁO: TÍN HIỆU BỊ CLIPPING" FontSize="15" FontWeight="Bold" Foreground="#EF4444"/>
                    <TextBlock x:Name="TxtSubtitle" Text="Room EQ Wizard (REW) Measurement Diagnostic" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Content="✕" Click="BtnClose_Click" Width="28" Height="28" 
                        Background="Transparent" Foreground="#71717A" BorderThickness="0" FontSize="14" Cursor="Hand" VerticalAlignment="Top"/>
            </Grid>

            <!-- 1: Level Meter Gauge (Visual dBFS Bar) -->
            <Border Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="THANG ĐO MỨC TÍN HIỆU PEAK (dBFS)" FontSize="10" FontWeight="SemiBold" Foreground="#71717A"/>
                        <TextBlock x:Name="TxtMeterPeakDisplay" Text="Peak: -0.1 dBFS" FontSize="11" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Gradient Meter Track -->
                    <Grid Height="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*"/> <!-- -60 to -30: Low -->
                            <ColumnDefinition Width="10*"/> <!-- -30 to -20: Fair -->
                            <ColumnDefinition Width="14*"/> <!-- -20 to -6: Target REW (Optimal) -->
                            <ColumnDefinition Width="5*"/>  <!-- -6 to -1: High -->
                            <ColumnDefinition Width="1*"/>  <!-- -1 to 0: Clip -->
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="4,0,0,4" ToolTip="Quá thấp (&lt; -30 dBFS)"/>
                        <Border Grid.Column="1" Background="#3F3F46" ToolTip="Hơi thấp (-30 đến -20 dBFS)"/>
                        <Border Grid.Column="2" Background="#10B981" ToolTip="Vùng lý tưởng REW (-20 đến -6 dBFS)"/>
                        <Border Grid.Column="3" Background="#F59E0B" ToolTip="Mức cao (-6 đến -1 dBFS)"/>
                        <Border Grid.Column="4" Background="#EF4444" CornerRadius="0,4,4,0" ToolTip="Clipping (&gt; -0.5 dBFS)"/>
                    </Grid>

                    <!-- Scale tick labels -->
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="-60" FontSize="9" Foreground="#52525B" HorizontalAlignment="Left"/>
                        <TextBlock Text="-30" FontSize="9" Foreground="#52525B" HorizontalAlignment="Left" Margin="140,0,0,0"/>
                        <TextBlock Text="-20" FontSize="9" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Left" Margin="185,0,0,0"/>
                        <TextBlock Text="TARGET REW (-20..-6)" FontSize="8" Foreground="#10B981" HorizontalAlignment="Left" Margin="215,0,0,0"/>
                        <TextBlock Text="-6" FontSize="9" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,50,0"/>
                        <TextBlock Text="0 dBFS" FontSize="9" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2: 4-Column Stats Box -->
            <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                <UniformGrid Columns="4">
                    <StackPanel>
                        <TextBlock Text="ĐỈNH PEAK" FontSize="10" Foreground="#71717A"/>
                        <TextBlock x:Name="TxtStatPeak" Text="-0.1 dBFS" FontSize="14" FontWeight="Bold" Foreground="#EF4444"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="HIỆU DỤNG RMS" FontSize="10" Foreground="#71717A"/>
                        <TextBlock x:Name="TxtStatRms" Text="-14.2 dBFS" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TỶ SỐ SNR" FontSize="10" Foreground="#71717A"/>
                        <TextBlock x:Name="TxtStatSnr" Text="45.0 dB" FontSize="14" FontWeight="Bold" Foreground="#4ADE80"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="TxtClippedSamplesHeader" Text="SỐ MẪU CLIP" FontSize="10" Foreground="#71717A"/>
                        <TextBlock x:Name="TxtStatClippedSamples" Text="128 mẫu" FontSize="14" FontWeight="Bold" Foreground="#F472B6"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- 3: Impact Description Box -->
            <Border Grid.Row="3" Background="#121214" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ẢNH HƯỞNG ĐẾN KẾT QUẢ ĐO:" FontSize="11" FontWeight="SemiBold" Foreground="#D4D4D8" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtImpactDescription" Text="Tín hiệu bị clipping khiến kết quả méo hài THD tăng vọt và đồ thị đáp tuyến SPL bị sai lệch." 
                               Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap" LineHeight="17"/>
                </StackPanel>
            </Border>

            <!-- 4: Solutions List -->
            <Border Grid.Row="4" Background="#121214" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="KHUYẾN NGHỊ KHẮC PHỤC CHUẨN REW:" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtRecommendations" Text="• Giảm âm lượng phát hoặc Sweep Level.&#x0a;• Giảm Microphone Recording Gain trong Windows Sound Settings.&#x0a;• Mức đỉnh lý tưởng trong REW là từ -20 dBFS đến -6 dBFS." 
                               Foreground="#D4D4D8" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </Border>

            <!-- 5: Action Buttons -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnKeep" Content="BỎ QUA &amp; GIỮ KẾT QUẢ" Click="BtnKeep_Click"
                        Background="#27272A" Foreground="#A1A1AA" BorderBrush="#3F3F46" BorderThickness="1"
                        Height="38" Margin="0,0,8,0" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="1" x:Name="BtnMeasureAgain" Content="🔄 ĐO LẠI (MEASURE AGAIN)" Click="BtnMeasureAgain_Click"
                        Background="#10B981" Foreground="#000000" BorderThickness="0"
                        Height="38" Padding="20,0" Cursor="Hand" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
